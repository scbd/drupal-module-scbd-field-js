{
  "name": "drupal-module-scbd-field-js",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.5.0",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "test:locales": "node --test src/i18n/locales.node-test.js",
    "preview": "vite preview --open",
    "release-dev-s3": "dist-builder releaseDev -f",
    "release": "yarn publish --access=public --tag latest",
    "clean-reinstall": "rm -f yarn.lock rm -f package-lock.json && rm -rf node_modules && CXXFLAGS=\"--std=c++17\" yarn install --force"
  },
  "main": "dist/index.min.js",
  "src": "src/index.js",
  "files": [
    "dist/*",
    "src/*"
  ],
  "browser": {
    "./": "dist/index.min.js",
    "./browser": "dist/index.min.js",
    "./style": "dist/style.css"
  },
  "exports": {
    ".": [
      {
        "import": "./dist/index.min.js",
        "require": "./dist/index.min.js",
        "style": "./dist/style.css",
        "src": "./src",
        "dist": "./dist",
        "default": "./dist/index.min.js"
      }
    ],
    "./dist/": "./dist/",
    "./src/": "./src/"
  },
  "dependencies": {
    "@scbd/cached-apis": "0.0.2",
    "change-case": "5.4.4",
    "vue": "^3.5.15",
    "vue-multiselect": "3.0.0-beta.1"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^5.0.0",
    "@vitejs/plugin-vue": "^4.3.4",
    "consola": "3.2.3",
    "rollup-plugin-terser": "^7.0.2",
    "sass": "1.32.11",
    "vite": "4.4.9"
  }
}
